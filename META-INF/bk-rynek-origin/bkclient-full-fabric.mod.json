{
  "schemaVersion": 1,
  "id": "bkclient",
  "version": "${version}",
  "name": "BK-Client Full",
  "description": "A polished Minecraft client with liquid-glass UI, visual modules, and quality-of-life features.",
  "authors": [
    "bkubiakdev"
  ],
  "contact": {
    "homepage": "https://bkubiak.dev/mods"
  },
  "license": "CC0-1.0",
  "icon": "assets/bkclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
        "dev.bkclient.MagicClassProposer",
        "dev.bkclient.BKClientPreLaunch"
    ]
},
  "mixins": [
    "bkclient.mixins.json",
    "bkclient-larp.mixins.json"
  ],
  "depends": {
    "fabricloader": "\u003e\u003d0.16.14",
    "minecraft": "~1.21.4",
    "java": "\u003e\u003d21",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  },
  "accessWidener": "bkclient.accesswidener",
  "jars": [
    {
      "file": "META-INF/jars/core-3.5.3.jar"
    },
    {
      "file": "META-INF/jars/javase-3.5.3.jar"
    },
    {
      "file": "META-INF/jars/nanohttpd-2.3.1.jar"
    }
  ]
}
